                    labels: [],
                    datasets: [
                        {
                            label: "AX (X-Axis)",
                            borderColor: "#26734D",
                            backgroundColor: "rgba(38, 115, 77, 0.1)",
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            tension: 0.15,
                            data: []
                        },
                        {
                            label: "AY (Y-Axis)",
                            borderColor: "#3B82F6",
                            backgroundColor: "rgba(59, 130, 246, 0.1)",
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            tension: 0.15,
                            data: []
                        },
                        {
                            label: "AZ (Z-Axis)",
                            borderColor: "#F59E0B",
                            backgroundColor: "rgba(245, 158, 11, 0.1)",
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            tension: 0.15,
                            data: []
                        }
                    ]
                },
                options: commonOptions
            });
        }

        // 2. Gyroscope Chart
        const gyroCtx = document.getElementById("gyroChart");
        if (gyroCtx) {
            gyroChart = new Chart(gyroCtx.getContext("2d"), {
                type: "line",
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: "GX (Roll Rate)",
                            borderColor: "#8B5CF6",
                            backgroundColor: "rgba(139, 92, 246, 0.1)",
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            tension: 0.15,
                            data: []
                        },
                        {
                            label: "GY (Pitch Rate)",
                            borderColor: "#EC4899",
                            backgroundColor: "rgba(236, 72, 153, 0.1)",
                            borderWidth: 1.75,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            tension: 0.15,
                            data: []
                        },
                        {
                            label: "GZ (Yaw Rate)",
                            borderColor: "#06B6D4",
