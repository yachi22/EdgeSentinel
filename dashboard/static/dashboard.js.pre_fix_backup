    // -------------------------------------------------------------------------
    // 5. Chart.js Time-Series Setup
    // -------------------------------------------------------------------------
    let accelChart = null;
    let gyroChart = null;
    let maxVisibleSamples = 30; // 30s, 60s, or 100s

    const historyBuffer = [];
    const MAX_BUFFER = 100;

    function getChartThemeColors() {
        const isDark = currentTheme === "dark";
        return {
            grid: isDark ? "#39414B" : "#E2E8F0",
            text: isDark ? "#A7B0BD" : "#64748B",
            tooltipBg: isDark ? "#22272E" : "#172B24",
            tooltipText: isDark ? "#F1F5F9" : "#FFFFFF",
            border: isDark ? "#39414B" : "#CBD5E1"
        };
    }

    function initCharts() {
        if (typeof Chart === "undefined") {
            console.warn("Chart.js not loaded yet");
            return;
        }

        const colors = getChartThemeColors();

        const commonOptions = {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            interaction: {
                mode: "index",
                intersect: false
            },
            plugins: {
                legend: {
                    position: "top",
                    labels: {
                        color: colors.text,
                        font: { size: 11, family: "Inter" },
                        boxWidth: 12,
                        padding: 12
                    }
                },
                tooltip: {
                    backgroundColor: colors.tooltipBg,
                    titleColor: colors.tooltipText,
                    bodyColor: colors.tooltipText,
                    borderColor: colors.border,
                    borderWidth: 1,
                    padding: 8,
                    bodyFont: { family: "JetBrains Mono", size: 11 }
                }
            },
            scales: {
                x: {
                    grid: { color: colors.grid, drawBorder: false },
                    ticks: {
                        color: colors.text,
                        font: { size: 10, family: "JetBrains Mono" },
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 6
                    }
                },
                y: {
                    grid: { color: colors.grid, drawBorder: false },
                    ticks: {
                        color: colors.text,
                        font: { size: 10, family: "JetBrains Mono" }
                    }
                }
            }
        };

        // 1. Accelerometer Chart
        const accelCtx = document.getElementById("accelChart");
